/* default class to allow transitions back to normal state */
.popup-panel-offscreen {
    translate: 0 300%;
    transition: translate 0.3s ease-in-bounce;
}

.popup-panel-onscreen {
    translate: none;
    transition: translate 0.3s ease-in-bounce;
    /* don't love this being defined here... might be better if we check goal sheep for animation complete? */
    transition-delay: 2.0s;
}